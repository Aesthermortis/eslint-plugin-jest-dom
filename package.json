{
  "name": "eslint-plugin-jest-dom",
  "version": "6.0.0",
  "description": "ESLint plugin to follow best practices and anticipate common mistakes when writing tests with jest-dom",
  "keywords": [
    "eslint",
    "eslintplugin",
    "eslint-plugin",
    "jest-dom",
    "testing-library",
    "react-testing-library",
    "dom-testing-library",
    "RTL",
    "DTL",
    "tests"
  ],
  "homepage": "https://github.com/Aesthermortis/eslint-plugin-jest-dom#readme",
  "bugs": {
    "url": "https://github.com/Aesthermortis/eslint-plugin-jest-dom/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Aesthermortis/eslint-plugin-jest-dom"
  },
  "license": "MIT",
  "author": "Aesthermortis",
  "type": "module",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./index.d.ts",
  "files": [
    "dist",
    "docs",
    "index.d.ts",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "prebuild": "node -e \"const fs=require('node:fs'); for (const dir of ['dist']) fs.rmSync(dir,{recursive:true,force:true});\"",
    "build": "rollup -c",
    "docs:check": "eslint-doc-generator --check",
    "predocs:update": "npm run build",
    "docs:update": "eslint-doc-generator",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "lint": "eslint . --cache --cache-strategy content --cache-location .cache/eslint/ --report-unused-disable-directives",
    "lint:fix": "eslint . --fix --cache --cache-strategy content --cache-location .cache/eslint/ --report-unused-disable-directives",
    "lint:remote": "eslint-remote-tester --config smoke-test/eslint-remote-tester.config.js",
    "prepack": "npm run build",
    "prepare": "husky && npm run build",
    "setup": "npm install && npm run validate",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --config ./jest.config.js --runInBand",
    "test:coverage": "npm test -- --coverage",
    "test:update": "npm test:coverage -- --updateSnapshot",
    "typecheck": "tsc --noEmit",
    "validate": "npm run typecheck && npm run lint && npm run test:coverage && npm run build && npm run docs:check && npm run format:check"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@eslint-community/eslint-plugin-eslint-comments": "^4.7.1",
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^1.2.0",
    "@eslint/markdown": "^8.0.1",
    "@homer0/prettier-plugin-jsdoc": "^11.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@testing-library/dom": "^10.4.1",
    "@types/eslint-plugin-security": "^3.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.6.0",
    "@typescript-eslint/parser": "^8.59.1",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-doc-generator": "^3.3.2",
    "eslint-plugin-eslint-plugin": "^7.3.2",
    "eslint-plugin-import-x": "^4.16.2",
    "eslint-plugin-jest": "^29.15.2",
    "eslint-plugin-jsdoc": "^62.9.0",
    "eslint-plugin-n": "^17.24.0",
    "eslint-plugin-regexp": "^3.1.0",
    "eslint-plugin-security": "^4.0.0",
    "eslint-plugin-sonarjs": "^4.0.3",
    "eslint-plugin-unicorn": "^64.0.0",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "jest": "^30.3.0",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.3",
    "prettier-plugin-packagejson": "^3.0.2",
    "rollup": "^4.60.2",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "@testing-library/dom": "^10.0.0",
    "eslint": "^10.0.0"
  },
  "peerDependenciesMeta": {
    "@testing-library/dom": {
      "optional": true
    }
  },
  "packageManager": "npm@11.13.0",
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
