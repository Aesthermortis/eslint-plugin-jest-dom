{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "esModuleInterop": true,
    "lib": ["ES2024"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2024",
    "types": ["node", "jest"],
    "verbatimModuleSyntax": true
  },
  "include": [
    "*.config.js",
    "index.d.ts",
    "src/**/*.js",
    "types/**/*.d.ts",
    "tests/**/*.js",
    "src/types.d.ts"
  ],
  "exclude": ["coverage", "dist", "node_modules", ".cache"]
}
